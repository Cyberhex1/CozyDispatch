# ============================================================================
# CozyDispatch — Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.

# ============================================================================
# AI (Required for AI-powered features)
# ============================================================================

# Gemini API key — Required for:
#   - Daily AI briefing (/api/gemini/daily-briefing)
#   - Vibe recommendations (/api/gemini/vibe-recommend)
#   - News article enrichment/summarization during incremental sync
#   - Game discovery quiz AI scoring
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# ============================================================================
# App URL (Required in production for self-referential links)
# ============================================================================

# The URL where this app is hosted (used in email unsubscribe links, OAuth, etc.)
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Example: https://cozydispatch.your-domain.com
APP_URL="http://localhost:3000"

# ============================================================================
# Email Provider (Required for actual email delivery)
# At least one provider key must be set to send real emails.
# Without any key, emails are logged to src/data/emailOutbox.json only.
# ============================================================================

# --- Option 1: Resend (recommended, free tier: 100 emails/day) ---
# Sign up at https://resend.com — generate an API key under API Keys.
# RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# --- Option 2: SendGrid ---
# Sign up at https://sendgrid.com — generate an API key with Mail Send permission.
# SENDGRID_API_KEY="SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# From address shown in outgoing emails.
# Must match a verified sender/domain in your email provider account.
# EMAIL_FROM="Cozy Dispatch <newsletter@yourdomain.com>"

# ============================================================================
# Notes
# ============================================================================
# - Sessions are stored in src/data/sessions.json (pruned automatically after 30 days)
# - Subscribers are stored in src/data/subscribers.json
# - News feed is stored in src/data/newsFeed.json
# - Game catalog is stored in src/data/steamGamesCatalog.json
# - Incremental sync state is stored in src/data/ingestionState.json
