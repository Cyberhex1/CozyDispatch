# CozyDispatch environment variables
# Copy to .env for local development (npm run dev). Never commit .env.
# In production, set these in Cloudflare Pages → Settings → Variables and Secrets.

# Public URL of the site, used in email links.
APP_URL="http://localhost:3000"

# --- Email (optional) --------------------------------------------------------
# Without these, newsletter signups are saved as "pending" and the site says
# that emails aren't switched on yet. Nothing is sent and nothing is faked.
# Resend (https://resend.com) needs a domain you own, verified in Resend.
# RESEND_API_KEY="re_..."
# EMAIL_FROM="Cozy Dispatch <hello@yourdomain.com>"

# --- Admin (optional) --------------------------------------------------------
# Long random string. Enables /api/admin/newsletter/* (stats, sending an issue).
# ADMIN_TOKEN=""

# --- Production sync (only for `npm run sync:remote`) --------------------------
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_TOKEN=""    # token with "D1 Edit" permission
# D1_DATABASE_ID="e8574478-bf2c-4d1c-9873-e83ad3408abe"
