{
  "name": "cozydispatch",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/server.cjs",
    "start": "NODE_ENV=production node dist-server/server.cjs",
    "sync": "tsx scripts/sync.ts",
    "sync:remote": "tsx scripts/sync.ts --remote",
    "db:migrate:remote": "wrangler d1 migrations apply cozydispatch-db --remote",
    "check:functions": "wrangler pages functions build --outdir=.wrangler/functions-check",
    "test": "tsx scripts/testAccount.ts && tsx scripts/testNewsletter.ts && tsx scripts/testSync.ts",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "wrangler": "^4.148.0"
  }
}
